---
interface LinkItem {
	href: string;
	label: string;
	primary?: boolean;
	external?: boolean;
	icon?: 'download' | 'github' | 'book-search';
}

interface ButtonItem {
	type: 'button';
	label: string;
	id: string;
}

interface Props {
	items: (LinkItem | ButtonItem)[];
}

const { items } = Astro.props;
---

<nav class="landing__actions">
	{items.map((item) => {
		if ('type' in item && item.type === 'button') {
			return (
				<button type="button" class="landing__btn" id={item.id}>
					<span class="landing__btn-label">{item.label}</span>
				</button>
			);
		}
		const link = item as LinkItem;
		return (
			<a
				class={`landing__btn ${link.primary ? 'landing__btn--primary' : ''}`}
				href={link.href}
				target={link.external ? '_blank' : undefined}
				rel={link.external ? 'noopener noreferrer' : undefined}
			>
				{link.icon === 'download' && (
					<svg class="landing__btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
				)}
				{link.icon === 'github' && (
					<svg class="landing__btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				)}
				{link.icon === 'book-search' && (
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-search-icon lucide-book-search"><path d="M11 22H5.5a1 1 0 0 1 0-5h4.501"/><path d="m21 22-1.879-1.878"/><path d="M3 19.5v-15A2.5 2.5 0 0 1 5.5 2H18a1 1 0 0 1 1 1v8"/><circle cx="17" cy="18" r="3"/></svg>
				)}
				<span class="landing__btn-label">{link.label}</span>
			</a>
		);
	})}
</nav>

<style>
	.landing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem 0.875rem;
		margin-top: 2rem;
		animation: fadeInUp var(--rams-duration-slow) var(--rams-ease-out) 0.12s both;
	}

	.landing__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 1rem;
		font-size: 0.9375rem;
		font-family: inherit;
		line-height: var(--rams-line-height-base);
		color: var(--rams-text);
		background: var(--rams-bg-elevated);
		border: 1px solid var(--rams-border);
		border-radius: var(--rams-radius);
		text-decoration: none;
		cursor: pointer;
		transition: border-color var(--rams-duration-normal) var(--rams-ease-out),
			background var(--rams-duration-normal) var(--rams-ease-out),
			color var(--rams-duration-normal) var(--rams-ease-out),
			transform var(--rams-duration-fast) var(--rams-ease-out);
	}
	.landing__btn:hover {
		border-color: var(--rams-accent);
		background: rgba(242, 174, 193, 0.15);
		color: var(--rams-text-strong);
		transform: translateY(-1px);
	}
	.landing__btn:active {
		transform: translateY(0);
	}
	.landing__btn--primary {
		background: var(--rams-accent);
		border-color: var(--rams-accent);
		color: #1a1a1a;
	}
	.landing__btn--primary:hover {
		background: var(--rams-accent-hover);
		border-color: var(--rams-accent-hover);
		color: #1a1a1a;
	}
	.landing__btn-icon {
		flex-shrink: 0;
	}
	.landing__btn-label {
		white-space: nowrap;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 720px) {
		.landing__actions {
			justify-content: center;
			margin-top: 1.75rem;
		}
	}
</style>
