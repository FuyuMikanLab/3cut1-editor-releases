---
interface Props {
	text?: string;
}

const { text = '© FuyuMikanLab' } = Astro.props;
---

<footer class="footer">
	<p class="footer__text">{text}</p>
</footer>

<style>
	.footer {
		flex-shrink: 0;
		padding: 0.75rem clamp(1.5rem, 5vw, 3rem) 1rem;
		border-top: 1px solid var(--rams-border);
		text-align: center;
	}

	.footer__text {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		letter-spacing: var(--rams-letter-spacing-body);
		color: var(--rams-text-muted);
	}
</style>
